# Application Environment ('dev' or 'prod')
ENV='prod'
PORT=5000

# Security Keys
JWT_KEY_SECRET='change_this_to_a_secure_random_string_in_production'

# Third Party SMS API Keys (Fast2SMS)
fast2sms_API_KEY='your_fast2sms_api_key'
fast2sms_SENDER_ID='INSOST'
fast2sms_MESSAGE_ID='175008'

# Production Database Configuration (Oracle Cloud Always Free MySQL / Remote DB)
DB_HOST='<ORACLE_VM_PUBLIC_IP_OR_HOSTNAME>'
DB_USER='adilabaduser'
DB_PASSWORD='your_secure_db_password'
DB_NAME='adilabadDb'

# Local Development Database Configuration
DEV_DB_HOST='localhost'
DEV_DB_USER='root'
DEV_DB_PASSWORD=''
DEV_DB_NAME='adilabadDb'

# Production & Development Base URLs
URL_BACKEND='https://adilabad-backend.onrender.com'
DEV_URL_BACKEND='http://localhost:5000'
URL_FRONTEND='https://www.adilabadapp.com'
DEV_URL_FRONTEND='http://localhost:3000'

# Cloud Object Storage Configuration (Oracle Object Storage / Cloudflare R2 / AWS S3)
STORAGE_PROVIDER='oracle' # Options: 'oracle', 'r2', 's3'
STORAGE_BUCKET_NAME='adilabad-media'
OCI_NAMESPACE='your_oci_tenancy_namespace'
OCI_REGION='ap-hyderabad-1'
OCI_CUSTOMER_SECRET_KEY_ID='your_oci_access_key_id'
OCI_CUSTOMER_SECRET_KEY='your_oci_secret_access_key'
STORAGE_PUBLIC_DOMAIN='https://objectstorage.ap-hyderabad-1.oraclecloud.com'
